# Copy this file to .env and adjust as needed. All values shown are defaults.

# --- Ollama (generation) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:1.7b
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_NUM_PREDICT=256
# NOTE: OLLAMA_NUM_PARALLEL is read here for documentation/consistency, but Ollama only
# honors it as an OS environment variable set BEFORE `ollama serve` starts, not as a
# per-request API field. See docs/OLLAMA.md.
OLLAMA_NUM_PARALLEL=1
# Seconds the LLM stays loaded after a call (0 = unload every call, -1 = forever).
OLLAMA_KEEP_ALIVE=300
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=60

# --- Embeddings ---
# sentence_transformers | ollama | mock
# See docs/OLLAMA.md for the full tradeoff. Short version: sentence_transformers gives
# better retrieval quality out of the box and needs no extra Ollama pull, but adds torch
# (~500MB-1GB RSS once loaded) and downloads its small model weights from Hugging Face on
# first use (one-time, cached locally after). ollama avoids torch entirely but requires
# `ollama pull nomic-embed-text` first (never pulled automatically by this app).
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# --- Storage ---
QDRANT_PATH=./data/indexes/qdrant
QDRANT_COLLECTION=documents
BM25_INDEX_PATH=./data/indexes/bm25/index.pkl
MANIFEST_PATH=./data/indexes/manifest.json
RAW_STORAGE_PATH=./data/raw
# Per-document derived artefacts (outline, extracted tables): one JSON sidecar
# per document at <PROCESSED_STORAGE_PATH>/<document_id>.<kind>.json.
PROCESSED_STORAGE_PATH=./data/processed

# --- Document analysis (V2 seams) ---
# All default off. Each flips a build_* factory in app/core/dependencies.py from
# its NoOp implementation to a real one once that backend is implemented. With
# every flag false the app behaves exactly as V1.
OCR_ENABLED=false                     # OCR scanned PDF pages with no text layer
TABLE_EXTRACTION_ENABLED=false        # write a real tables sidecar per document
STRUCTURED_EXTRACTION_ENABLED=false   # POST /documents/{id}/extract
COMPARE_ENABLED=false                 # POST /compare

# --- Chunking ---
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40

# --- Retrieval ---
RETRIEVAL_CANDIDATE_K=20
RRF_K=60
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=20

# --- Generation / context budgeting ---
GENERATION_PROVIDER=ollama
PROMPT_OVERHEAD_TOKENS=150
CONTEXT_SAFETY_MARGIN=0.85

# --- Misc ---
LOG_LEVEL=INFO
# Load the embedding model and LLM in the background at server start (faster first query).
WARMUP_ON_STARTUP=true
