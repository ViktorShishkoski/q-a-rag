%% =====================================================================
%% Q&A RAG - Detailed Feature / Subsystem Diagrams (Level 3)
%% One subgraph per discovered feature. Verified against source 2026-09-10.
%% (Kept as a single valid Mermaid diagram; per-feature blocks also appear
%%  individually in docs/architecture/architecture-report.md.)
%%
%% ["..."] module/function  {"..."} decision  [("...")] store  ("...") boundary
%% =====================================================================
flowchart TB
    classDef mod fill:#F5EFE0,stroke:#C9BFA8,stroke-width:1px,color:#3b3a36;
    classDef dec fill:#EDE3C8,stroke:#BFA76F,stroke-width:1px,color:#3b3a36;
    classDef db  fill:#E7DEC6,stroke:#B9A97F,stroke-width:1px,color:#3b3a36;
    classDef io  fill:#FBF8F1,stroke:#D3C9AE,stroke-width:1px,color:#3b3a36;

    %% ---------------- F1: Document ingestion ----------------
    subgraph F1["F1 - Document ingestion (app/ingestion)"]
        direction TB
        f1_in("POST /documents or scripts/ingest.py")
        f1_route["routes_documents.upload_document<br/>suffix allow-list .pdf/.md/.markdown"]
        f1_svc["IngestionService.ingest_document"]
        f1_load["loaders.load_document -> load_pdf (fitz) / load_markdown<br/>heading + section detection"]
        f1_clean["cleaning.clean_text + strip_repeated_headers_footers"]
        f1_chunk["chunking.chunk_text (tiktoken cl100k_base)"]
        f1_meta["metadata: sha256 document_id + chunk_id"]
        f1_ocr{"page has no text AND ocr.enabled?"}
        f1_ocrcall["ocr_engine.ocr_page (NoOp -> None -> IngestionWarning)"]
        f1_embed["embeddings.embed_documents (batched)"]
        f1_idem{"manifest.has(document_id)?"}
        f1_q[("Qdrant upsert")]
        f1_b[("BM25 upsert + save")]
        f1_m[("manifest.put")]
        f1_raw[("data/raw write")]
        f1_side[("data/processed outline + tables sidecars")]
        f1_out("IngestResponse {document, chunks_created, skipped}")
    end
    f1_in --> f1_route --> f1_svc --> f1_load --> f1_clean --> f1_chunk --> f1_meta
    f1_load --> f1_ocr
    f1_ocr -->|yes| f1_ocrcall
    f1_svc --> f1_side
    f1_svc --> f1_raw
    f1_svc --> f1_idem
    f1_idem -->|yes| f1_out
    f1_idem -->|no| f1_embed
    f1_chunk --> f1_embed
    f1_embed --> f1_q
    f1_meta --> f1_b
    f1_svc --> f1_m
    f1_m --> f1_out

    %% ---------------- F2: Hybrid retrieval ----------------
    subgraph F2["F2 - Hybrid retrieval + RRF + optional rerank (app/retrieval)"]
        direction TB
        f2_in("RetrievalService.search(query, top_k, filters, rerank)")
        f2_dense["DenseRetriever: embed_query -> vector_store.search(candidate_k, DocumentFilter)"]
        f2_sparse["SparseRetriever: bm25_store.search(candidate_k)"]
        f2_rrf["fusion.reciprocal_rank_fusion(k=RRF_K)<br/>score = sum 1/(k+rank)"]
        f2_dec{"use rerank? request.rerank ?? RERANK_ENABLED"}
        f2_ce["CrossEncoderReranker.rerank (lazy CrossEncoder load)"]
        f2_top["fused[:top_k]"]
        f2_out("list[ScoredChunk] with dense/sparse/fused/rerank scores")
    end
    f2_in --> f2_dense --> f2_rrf
    f2_in --> f2_sparse --> f2_rrf
    f2_rrf --> f2_dec
    f2_dec -->|yes| f2_ce --> f2_out
    f2_dec -->|no| f2_top --> f2_out

    %% ---------------- F3: Grounded generation ----------------
    subgraph F3["F3 - Grounded generation + citation verification (app/generation)"]
        direction TB
        f3_in("GenerationService.answer(question, retrieved_chunks)")
        f3_ctx["context.build_context(budget)<br/>budget = (ctx_len - num_predict - overhead) * safety_margin"]
        f3_prompt["prompts.build_prompt + SYSTEM_PROMPT<br/>CITATION_TAG_PATTERN is single source of truth"]
        f3_provider{"generation_provider"}
        f3_ollama["OllamaGenerationProvider.generate<br/>POST /api/generate (httpx)"]
        f3_mock["MockGenerationProvider.generate (offline)"]
        f3_cit["citations.extract_citations<br/>keep only tags resolving to an included chunk"]
        f3_out("AnswerResult -> QueryResponse<br/>answer, citations, ContextInfo, model, timing_ms")
    end
    f3_in --> f3_ctx --> f3_prompt --> f3_provider
    f3_provider -->|ollama| f3_ollama --> f3_cit
    f3_provider -->|mock| f3_mock --> f3_cit
    f3_cit --> f3_out

    %% ---------------- F4: Document management ----------------
    subgraph F4["F4 - Document management (routes_documents + DocumentService)"]
        direction TB
        f4_list("GET /documents -> list_documents -> manifest.list")
        f4_del("DELETE /documents/{id} -> delete_document")
        f4_file("GET /documents/{id}/file -> raw_file -> FileResponse")
        f4_guard{"manifest.get(id) exists?"}
        f4_404("DocumentNotFoundError -> 404")
        f4_deldo["vector_store.delete_document + sparse.delete_document + save<br/>manifest.remove + unlink raw + unlink sidecars"]
    end
    f4_del --> f4_guard
    f4_file --> f4_guard
    f4_guard -->|no| f4_404
    f4_guard -->|yes| f4_deldo

    %% ---------------- F5: Outline extraction ----------------
    subgraph F5["F5 - Outline extraction (app/analysis/outline.py)"]
        direction TB
        f5_write["IngestionService._write_outline (every ingest, backfills old docs)"]
        f5_build["build_outline(blocks)<br/>MD depth from ' > ' breadcrumb; PDF depth from numeric prefix"]
        f5_side[("data/processed/ID.outline.json")]
        f5_api("GET /documents/{id}/outline -> OutlineResponse (or [] / 404)")
        f5_fe["frontend DocumentOutline (useOutline, lazy on expand)"]
    end
    f5_write --> f5_build --> f5_side
    f5_side --> f5_api --> f5_fe

    %% ---------------- F6: V2 analysis seams ----------------
    subgraph F6["F6 - V2 analysis seams (all NoOp, flags default false)"]
        direction TB
        f6_ocr["OcrEngine / NoOpOcrEngine (OCR_ENABLED)"]
        f6_tab["TableExtractor / NoOpTableExtractor (TABLE_EXTRACTION_ENABLED)<br/>GET /documents/{id}/tables"]
        f6_ext["StructuredExtractor / NoOp (STRUCTURED_EXTRACTION_ENABLED)<br/>POST /documents/{id}/extract -> implemented:false"]
        f6_cmp["DocumentComparer / NoOp (COMPARE_ENABLED)<br/>POST /compare -> implemented:false, needs >=2 ids"]
        f6_deps{"build_* factory in app/core/dependencies.py<br/>branches on Settings flag"}
    end
    f6_deps --> f6_ocr
    f6_deps --> f6_tab
    f6_deps --> f6_ext
    f6_deps --> f6_cmp

    %% ---------------- F7: Evaluation harness ----------------
    subgraph F7["F7 - Offline evaluation (app/evaluation + scripts/evaluate.py)"]
        direction TB
        f7_in("scripts/evaluate.py --dataset ...")
        f7_ds["dataset.load_dataset -> list[EvalCase]"]
        f7_run["benchmark.run_benchmark<br/>per case: retrieval_service.search + generation_service.answer"]
        f7_me["metrics: recall_at_k, mrr, ndcg_at_k, lexical_overlap, citation_presence"]
        f7_rep["reporting.write_report"]
        f7_out[("data/evaluation/report_TS.json + .md")]
    end
    f7_in --> f7_ds --> f7_run --> f7_me
    f7_run --> f7_rep --> f7_out

    %% ---------------- F8: Health ----------------
    subgraph F8["F8 - Health check (routes_health.py)"]
        direction TB
        f8_in("GET /health")
        f8_o["generation_provider.health_check + is_model_available"]
        f8_q["vector_store.count()"]
        f8_dec{"reachable AND model_available AND qdrant_ok?"}
        f8_out("HealthResponse status ok or degraded")
    end
    f8_in --> f8_o --> f8_dec
    f8_in --> f8_q --> f8_dec
    f8_dec --> f8_out

    %% ---------------- F9: Frontend retrieval console ----------------
    subgraph F9["F9 - Frontend retrieval console (frontend/src)"]
        direction TB
        f9_shell["AppShell + StatusPill (useHealth poll 15s)"]
        f9_upload["UploadDropzone (useUploadDocument -> POST /documents)"]
        f9_list["DocumentList (useDocuments, useDeleteDocument) + DocumentOutline"]
        f9_chat["ChatPanel (useAskQuestion -> POST /query)"]
        f9_answer["AnswerView: linkifyCitations -> react-markdown superscript refs"]
        f9_chunks["RetrievedChunksPanel: highlights context.chunk_ids used"]
        f9_pdf["PdfViewerDialog: react-pdf / markdown via GET /documents/{id}/file"]
    end
    f9_shell --> f9_upload
    f9_shell --> f9_list
    f9_shell --> f9_chat
    f9_chat --> f9_answer
    f9_chat --> f9_chunks
    f9_answer --> f9_pdf
    f9_chunks --> f9_pdf

    class f1_in,f1_out,f2_in,f2_out,f3_in,f3_out,f4_list,f4_del,f4_file,f4_404,f5_api,f7_in,f8_in,f8_out io;
    class f1_ocr,f1_idem,f2_dec,f3_provider,f4_guard,f6_deps,f8_dec dec;
    class f1_q,f1_b,f1_m,f1_raw,f1_side,f5_side,f7_out db;
    class f1_route,f1_svc,f1_load,f1_clean,f1_chunk,f1_meta,f1_ocrcall,f1_embed,f2_dense,f2_sparse,f2_rrf,f2_ce,f2_top,f3_ctx,f3_prompt,f3_ollama,f3_mock,f3_cit,f4_deldo,f5_write,f5_build,f5_fe,f6_ocr,f6_tab,f6_ext,f6_cmp,f7_ds,f7_run,f7_me,f7_rep,f8_o,f8_q,f9_shell,f9_upload,f9_list,f9_chat,f9_answer,f9_chunks,f9_pdf mod;
